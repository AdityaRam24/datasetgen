# Copy to `.env` (git-ignored) and fill in. Nothing here is a cloud LLM key —
# generation is always local.

# --- Local LLM (overrides config.toml [llm]) --------------------------------
DATAGEN_LLM_BASE_URL=http://localhost:11434
DATAGEN_LLM_MODEL=qwen2.5:7b-instruct
DATAGEN_EMBED_MODEL=nomic-embed-text

# --- Confluence -------------------------------------------------------------
# Cloud:  BASE_URL=https://your-org.atlassian.net/wiki
#         USER=you@example.com   TOKEN=<API token from id.atlassian.com>
# Server/Data Center: leave USER empty and put a Personal Access Token in TOKEN
#         (it is then sent as `Authorization: Bearer <TOKEN>`).
CONFLUENCE_BASE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=

# --- Optional: authenticated crawl targets ----------------------------------
# Extra headers applied to [[sources.web]] fetches, as JSON.
DATAGEN_WEB_HEADERS=

# --- Networking -------------------------------------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
